@{
    ViewData["Title"] = "Reservaciones";
}

<h2 class="text-center mb-5">Gestión de Reservaciones</h2>

<div class="d-flex justify-content-center gap-4 flex-wrap">

    <a asp-action="Create" class="btn btn-success btn-lg">➕ Crear</a>

    <a asp-action="Read" class="btn btn-primary btn-lg">🔍 Ver Reservaciones</a>

    <a asp-action="ReporteSemanal" class="btn btn-info btn-lg">📊 Reporte semanal</a>

    <a asp-action="Edit" class="btn btn-warning btn-lg">✏️ Editar Reservaciones</a>

    <a asp-action="Delete" class="btn btn-danger btn-lg">❌ Eliminar Reservaciones</a>

</div>
