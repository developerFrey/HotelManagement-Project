@{
    ViewData["Title"] = "Empleados";
}

<h2 class="text-center mb-5">Gestión de Empleados</h2>

<div class="d-flex justify-content-center gap-4 flex-wrap">

    <a asp-action="Create" class="btn btn-success btn-lg">➕ Crear</a>

    <a asp-action="Read" class="btn btn-primary btn-lg">🔍 Ver Empleados</a>

    <a asp-action="Edit" class="btn btn-warning btn-lg">✏️ Editar Empleados</a>

    <a asp-action="Delete" class="btn btn-danger btn-lg">❌ Eliminar Empleados</a>

</div>
